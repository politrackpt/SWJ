<#ParliamentarianRequisitionRelationMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Req/RequerimentosAtivDepOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../../../Deputado/DepCadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-mpact:didRequisition ;
        rr:objectMap [
            rr:template "http://purl.org/polis/ar/graph#Requisition_{ReqId}" ;
            rr:termType rr:IRI ;
        ]
    ] ;
    .

<#ParliamentarianYPARelationMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/ParlamentoJovens/DadosDeputado" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../../../Deputado/DepCadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-mpact:didYouthParliamentActivity ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:hashIri ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:prefix ;
                    rr:objectMap [ rr:constant "urn:ypa:" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "Legislatura" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "Data" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "TipoReuniao" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "Estabelecimento" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "CirculoEleitoral" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "Sessao" ]
                ]
            ]
        ]
    ] ;
    .

<#ParliamentarianFriendshipParliamentaryGroupRelationMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Gpa/GruposParlamentaresAmizadeOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../../../Deputado/DepCadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-core:hasMembership ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:hashIri ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:prefix ;
                    rr:objectMap [ rr:constant "urn:membership:" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "GplId" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "CgaDtini" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "CgaDtfim" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "CgaCrg" ]
                ]
            ]
        ]
    ] ;
    .

<#ParliamentarianFriendshipParliamentaryGroupMembershipMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Gpa/GruposParlamentaresAmizadeOut" ;
    ] ;

    rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class polis-core:Membership ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:hashIri ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:prefix ;
                rr:objectMap [ rr:constant "urn:membership:" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "GplId" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "CgaDtini" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "CgaDtfim" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "CgaCrg" ]
            ]
        ] ;
    ] ;

    # Group
    rr:predicateObjectMap [
        rr:predicate polis-core:isMemberOf ;
        rr:objectMap [
            rr:template "http://purl.org/polis/ar/graph#FriendshipParliamentaryGroup_{GplId}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Date Period
    rr:predicateObjectMap [
        rr:predicate dct:date ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toIso8601Period ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:startDate ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:toXsdDateTime ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputDateTime ;
                                rr:objectMap [ rml:reference "CgaDtini" ]
                            ]
                        ] ;
                        rr:datatype xsd:dateTime
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:endDate ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:toXsdDateTime ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputDateTime ;
                                rr:objectMap [ rml:reference "CgaDtfim" ]
                            ]
                        ] ;
                        rr:datatype xsd:dateTime
                    ]
                ]
            ] ;
        ]
    ] ;

    # Role
    rr:predicateObjectMap [
        rr:predicate polis-core:role ;
        rr:objectMap [
            rml:reference "CgaCrg" ;
            rr:datatype xsd:string
        ]
    ] ;
    .

<#ParliamentarianPublicAccountRelationMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Rel/RelatoresContasPublicas/RelatoresContasPublicasOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../../../../Deputado/DepCadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-mpact:wasRapporteurIn ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#PublicAccount_" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [ rml:reference "ActId" ]
                ]
            ]
        ]
    ] ;
    .

<#ParliamentarianParliamentaryActivityRelationMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/ActP/ActividadesParlamentaresOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../../../Deputado/DepCadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-core:didParliamentaryActivity ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:hashIri ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:prefix ;
                    rr:objectMap [ rr:constant "urn:paract:" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [
                        rml:reference "ActTp" ;
                    ]
                ]  ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [
                        rml:reference "ActId" ;
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [
                        rml:reference "ActSelLg" ;
                    ]
            ] ;
            ]
        ]
    ] ;
    .

