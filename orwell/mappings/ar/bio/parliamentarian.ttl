<#ParliamentarianEventRelationMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Eventos/ActividadesComissaoOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../../../Deputado/DepCadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-core:didCommissionActivity ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Event_" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [ rml:reference "ActId" ]
                ]
            ]
        ]
    ] ;
    .
