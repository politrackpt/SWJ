@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:    <https://w3id.org/function/ontology#> .
@prefix pofn:   <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> . # TODO: Update URI to match where the pofn file is hosted
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:    <http://www.w3.org/XML/1998/namespace> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix ocd:    <http://dati.camera.it/ocd/> .
@prefix m4s:    <http://purl.org/map4scrutiny-core#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix prov:   <https://www.w3.org/ns/prov-o#> .
@prefix pe:     <https://ukparliament.github.io/ontologies/election/election-ontology.ttl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix sem: <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix polis-ini:    <http://purl.org/polis/ar/initiatives#> .
@prefix polis-bio:    <http://purl.org/polis/ar/biographic#> .
@prefix polis-core:   <http://purl.org/polis/ar/core#> .
@prefix polis-mpact:  <http://purl.org/polis/ar/mp-activity#> .
@prefix polis-graph:  <http://purl.org/polis/ar/graph#> .

<#PermanentDelegationMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/DlP/DelegacoesPermanentesOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#PermanentDelegation_{DepId}" ;
        rr:class polis-mpact:PermanentDelegation
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [
            rml:reference "DepId" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "DepNo" ; ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;

    # Legislature
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [
            rr:template "http://purl.org/polis/ar/graph#{DepSelLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Legislative Session
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislativeSession ;
        rr:objectMap [
            rr:template "http://purl.org/polis/ar/graph#Session_{DepSelNr}_of_{DepSelLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;
    .

<#PermanentDelegationMeetingRelationMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/DlP/DelegacoesPermanentesOut/DepReunioes/ReunioesDelegacoesPermanentes" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#PermanentDelegation_{../../DepId}" ;
        rr:class polis-mpact:PermanentDelegation
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-mpact:hasPermanentDelegationMeeting ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:hashIri ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:prefix ;
                    rr:objectMap [ rr:constant "urn:pdm:" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "RenLoc" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "RenDtIni" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "RenDtFim" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "RenTi" ]
                ]
            ]
        ]
    ] ;
    .

<#PermanentDelegationMeetingMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/DlP/DelegacoesPermanentesOut/DepReunioes/ReunioesDelegacoesPermanentes" ;
    ] ;

    rr:subjectMap [
        rr:class polis-mpact:PermanentDelegationMeeting ;
        rr:termType rr:IRI ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:hashIri ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:prefix ;
                rr:objectMap [ rr:constant "urn:pdm:" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "RenLoc" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "RenDtIni" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "RenDtFim" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "RenTi" ]
            ]
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [
            rml:reference "RenTi" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Location
    rr:predicateObjectMap [
        rr:predicate sem:hasPlace ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Place_" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:normalize ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputString ;
                                rr:objectMap [ rml:reference "RenLoc" ]
                            ]
                        ] ;
                    ]
                ]
            ]
        ]
    ] ;

    # Date Period
    rr:predicateObjectMap [
        rr:predicate dct:date ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toIso8601Period ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:startDate ;
                    rr:objectMap [
                        rml:reference "RenDtIni" ;
                        rr:datatype xsd:date
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:endDate ;
                    rr:objectMap [
                        rml:reference "RenDtFim" ;
                        rr:datatype xsd:date
                    ]
                ]
            ] ;
        ]
    ] ;
    .

<#TemporaryDelegationMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/DlE/DelegacoesEventuaisOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#TemporaryDelegation_{DevId}" ;
        rr:class polis-mpact:TemporaryDelegation
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [
            rml:reference "DevId" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "DevNo" ; ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;

    # Legislature
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [
            rr:template "http://purl.org/polis/ar/graph#{DevSelLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Legislative Session
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislativeSession ;
        rr:objectMap [
            rr:template "http://purl.org/polis/ar/graph#Session_{DevSelNr}_of_{DevSelLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Date Period (with conversion to xsd:dateTime)
    rr:predicateObjectMap [
        rr:predicate dct:date ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toIso8601Period ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:startDate ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:toXsdDateTime ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputDateTime ;
                                rr:objectMap [ rml:reference "DevDtini" ]
                            ]
                        ] ;
                        rr:datatype xsd:dateTime
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:endDate ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:toXsdDateTime ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputDateTime ;
                                rr:objectMap [ rml:reference "DevDtfim" ]
                            ]
                        ] ;
                        rr:datatype xsd:dateTime
                    ]
                ]
            ] ;
        ]
    ] ;

    # Location
    rr:predicateObjectMap [
        rr:predicate sem:hasPlace ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Place_" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:normalize ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputString ;
                                rr:objectMap [ rml:reference "DevLoc" ]
                            ]
                        ] ;
                    ]
                ]
            ]
        ]
    ] ;

    # Scope
    rr:predicateObjectMap [
        rr:predicate polis-mpact:hasDelegationScope ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toClass ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:entityName ;
                    rr:objectMap [ rml:reference "DevTp" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:className ;
                    rr:objectMap [ rr:constant "delegationScope" ]
                ] ;
            ]
        ]
    ] ;
    .

<#PlaceMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/DlE/DelegacoesEventuaisOut" ;
    ] ;

    rr:subjectMap [
        rr:class sem:Place ;
        rr:termType rr:IRI ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:stringConcat ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:leftPart ;
                rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Place_" ; ]
            ];
            rr:predicateObjectMap [
                rr:predicate pofn:rightPart ;
                rr:objectMap [
                    fnml:functionValue [
                        rr:predicateObjectMap [
                            rr:predicate fno:executes ;
                            rr:objectMap [ rr:constant pofn:normalize ]
                        ] ;
                        rr:predicateObjectMap [
                            rr:predicate pofn:inputString ;
                            rr:objectMap [ rml:reference "DevLoc" ; ]
                        ]
                    ] ;
                ]
            ]
        ] ;
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [
            rml:reference "DevLoc" ;
            rr:datatype xsd:string
        ]
    ]
    .

<#PermanentDelegationMeetingPlaceMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "atividadedeputado" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/DlP/DelegacoesPermanentesOut/DepReunioes/ReunioesDelegacoesPermanentes" ;
    ] ;

    rr:subjectMap [
        rr:class sem:Place ;
        rr:termType rr:IRI ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:stringConcat ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:leftPart ;
                rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Place_" ; ]
            ];
            rr:predicateObjectMap [
                rr:predicate pofn:rightPart ;
                rr:objectMap [
                    fnml:functionValue [
                        rr:predicateObjectMap [
                            rr:predicate fno:executes ;
                            rr:objectMap [ rr:constant pofn:normalize ]
                        ] ;
                        rr:predicateObjectMap [
                            rr:predicate pofn:inputString ;
                            rr:objectMap [ rml:reference "RenLoc" ; ]
                        ]
                    ] ;
                ]
            ]
        ] ;
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [
            rml:reference "RenLoc" ;
            rr:datatype xsd:string
        ]
    ]
    .
