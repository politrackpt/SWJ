@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:    <https://w3id.org/function/ontology#> .
@prefix pofn:   <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> . # TODO: Update URI to match where the pofn file is hosted
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:    <http://www.w3.org/XML/1998/namespace> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix ocd:    <http://dati.camera.it/ocd/> .
@prefix m4s:    <http://purl.org/map4scrutiny-core#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix prov:   <https://www.w3.org/ns/prov-o#> .
@prefix pe:     <https://ukparliament.github.io/ontologies/election/election-ontology.ttl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix sem: <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix polis-ini:    <http://purl.org/polis/ar/initiatives#> .
@prefix polis-bio:    <http://purl.org/polis/ar/biographic#> .
@prefix polis-core:   <http://purl.org/polis/ar/core#> .
@prefix polis-mpact:  <http://purl.org/polis/ar/mp-activity#> .
@prefix polis-graph:  <http://purl.org/polis/ar/graph#> .

<#CommissionMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "composicaodeorgaos" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/OrganizacaoAR/Comissoes/OrgaoBase/DetalheOrgao" ;
    ] ;

    rr:subjectMap [
        rr:class polis-core:Commission ;
        rr:termType rr:IRI ;
        rr:template "http://purl.org/polis/ar/graph#Commission_{idOrgao}" ;
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [
            rml:reference "idOrgao" ;
            rr:datatype xsd:string
        ] ;
    ] ;

    # Acronym
    rr:predicateObjectMap [
        rr:predicate qudt:acronym ;
        rr:objectMap [
            rml:reference "siglaOrgao" ;
            rr:datatype xsd:string
        ] ;
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "nomeSigla" ]
                ]
            ] ;
            rr:datatype xsd:string
        ] ;
    ] ;

    # Legislature
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [
            rr:template "http://purl.org/polis/ar/graph#{siglaLegislatura}" ;
            rr:termType rr:IRI ;
        ] ;
    ] ;

    # Number
    rr:predicateObjectMap [
        rr:predicate dbo:number ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stripDecimal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "numeroOrgao" ]
                ]
            ] ;
            rr:datatype xsd:nonNegativeInteger
        ] ;
    ]
    .

<#CommissionMembershipMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "composicaodeorgaos" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/OrganizacaoAR/Comissoes/OrgaoBase/HistoricoComposicao/pt_ar_wsgode_objectos_DadosOrgaoComposicaoHistorico" ;
    ] ;

    rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class polis-core:Membership ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:hashIri ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:prefix ;
                rr:objectMap [ rr:constant "urn:membership:" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "orgId" ]
            ] ;
            # rr:predicateObjectMap [
            #     rr:predicate pofn:elements ;
            #     rr:objectMap [ rml:reference "depSituacao" ]
            # ] ;
        ] ;
    ] ;

    # Commission
    rr:predicateObjectMap [
        rr:predicate polis-core:isMemberOf ;
        rr:objectMap [
            rr:template "http://purl.org/polis/ar/graph#Commission_{orgId}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # TODO: Adicionar Situation information à membership, cada situação terá uma data
    .

