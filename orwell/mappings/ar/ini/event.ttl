<#EventJointInitiativeMap> a rr:TriplesMap ;

	rml:logicalSource [
	    rml:source "iniciativas" ;
	    rml:referenceFormulation ql:XPath ;
	    rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/IniciativasConjuntas/pt_gov_ar_objectos_iniciativas_DiscussaoConjuntaOut" ;
	 ] ;

	rr:subjectMap [
		rr:class polis-ini:Event ;
		rr:termType rr:IRI ;
		fnml:functionValue [
			rr:predicateObjectMap [
				rr:predicate fno:executes ;
				rr:objectMap [ rr:constant pofn:hashIri ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:prefix ;
				rr:objectMap [ rr:constant "urn:event:" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "../../OevId" ]
			] ;
		]
	] ;

	# Joint Initiative
	rr:predicateObjectMap [
		rr:predicate polis-ini:happensJointlyWithInitiative ;
		rr:objectMap [
			rr:termType rr:IRI ;
			fnml:functionValue [
				rr:predicateObjectMap [
					rr:predicate fno:executes ;
					rr:objectMap [ rr:constant pofn:stringConcat ]
				] ;
				rr:predicateObjectMap [
					rr:predicate pofn:leftPart ;
					rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Initiative_" ]
				] ;
				rr:predicateObjectMap [
					rr:predicate pofn:rightPart ;
					rr:objectMap [ rml:reference "id" ]
				] ;
			]
		]
	] ;
	.

<#EventJointPetitionMap> a rr:TriplesMap ;

	rml:logicalSource [
	    rml:source "iniciativas" ;
	    rml:referenceFormulation ql:XPath ;
	    rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/PeticoesConjuntas/pt_gov_ar_objectos_iniciativas_DiscussaoConjuntaOut" ;
	 ] ;

	rr:subjectMap [
		rr:class polis-ini:Event ;
		rr:termType rr:IRI ;
		fnml:functionValue [
			rr:predicateObjectMap [
				rr:predicate fno:executes ;
				rr:objectMap [ rr:constant pofn:hashIri ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:prefix ;
				rr:objectMap [ rr:constant "urn:event:" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "../../OevId" ]
			] ;
		]
	] ;

	# Joint Petition
	rr:predicateObjectMap [
		rr:predicate polis-ini:discussedJointlyWith ;
		rr:objectMap [
			rr:termType rr:IRI ;
			fnml:functionValue [
				rr:predicateObjectMap [
					rr:predicate fno:executes ;
					rr:objectMap [ rr:constant pofn:stringConcat ]
				] ;
				rr:predicateObjectMap [
					rr:predicate pofn:leftPart ;
					rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Petition_" ]
				] ;
				rr:predicateObjectMap [
					rr:predicate pofn:rightPart ;
					rr:objectMap [
					 	fnml:functionValue [
							rr:predicateObjectMap [
								rr:predicate fno:executes ;
								rr:objectMap [ rr:constant pofn:stringConcat ]
							] ;
							rr:predicateObjectMap [
								rr:predicate pofn:leftPart ;
								rr:objectMap [ rml:reference "nr" ]
							] ;
							rr:predicateObjectMap [
								rr:predicate pofn:rightPart ;
								rr:objectMap [
									fnml:functionValue [
										rr:predicateObjectMap [
											rr:predicate fno:executes ;
											rr:objectMap [ rr:constant pofn:stringConcat ]
										] ;
										rr:predicateObjectMap [
											rr:predicate pofn:leftPart ;
											rr:objectMap [ rr:constant "_of_" ]
										] ;
										rr:predicateObjectMap [
											rr:predicate pofn:rightPart ;
											rr:objectMap [ rml:reference "leg" ]
										]
									]
								]
							]
						]
					]
				] ;
			]
		]
	] ;
	.

<#EventDiscussionRelationMap> a rr:TriplesMap ;

    rml:logicalSource [
	    rml:source "iniciativas" ;
	    rml:referenceFormulation ql:XPath ;
	    rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/Intervencoesdebates/pt_gov_ar_objectos_IntervencoesOut" ;
	] ;

	rr:subjectMap [
		rr:class polis-ini:Event ;
		rr:termType rr:IRI ;
		fnml:functionValue [
			rr:predicateObjectMap [
				rr:predicate fno:executes ;
				rr:objectMap [ rr:constant pofn:hashIri ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:prefix ;
				rr:objectMap [ rr:constant "urn:event:" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "../../OevId" ]
			] ;
		]
	] ;

	rr:predicateObjectMap [
		rr:predicate polis-ini:hasDiscussion ;
		rr:objectMap [
			rr:termType rr:IRI ;
			fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:hashIri ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:prefix ;
                rr:objectMap [ rr:constant "urn:discussion:" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "dataReuniaoPlenaria" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "oradores" ]
            ] ;
        ]
		]
	] ;
	.

<#EventParliamentarianAppealMap> a rr:TriplesMap ;

    rml:logicalSource [
	    rml:source "iniciativas" ;
	    rml:referenceFormulation ql:XPath ;
	    rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/RecursoDeputados/string" ;
	] ;

	rr:subjectMap [
		rr:class polis-ini:Event ;
		rr:termType rr:IRI ;
		fnml:functionValue [
			rr:predicateObjectMap [
				rr:predicate fno:executes ;
				rr:objectMap [ rr:constant pofn:hashIri ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:prefix ;
				rr:objectMap [ rr:constant "urn:event:" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "../../OevId" ]
			] ;
		]
	] ;

	# Appeal Parliamentarian
	rr:predicateObjectMap [
	    rr:predicate polis-ini:receivedAppeal ;
		rr:objectMap [
		    rr:termType rr:IRI ;
			fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:stringConcat ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:leftPart ;
                rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Parliamentarian_" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:rightPart ;
                rr:objectMap [
                    fnml:functionValue [
         			    rr:predicateObjectMap [
         			        rr:predicate fno:executes ;
         			        rr:objectMap [ rr:constant pofn:lookup ]
         			    ] ;
         			    rr:predicateObjectMap [
         			        rr:predicate pofn:lookupTable ;
         			        rr:objectMap [ rr:constant "ParliamentarianIdentification" ]
         			    ] ;
         			    rr:predicateObjectMap [
         			        rr:predicate pofn:lookupValue ;
         			        rr:objectMap [ rml:reference "../../../../IniLeg" ]
         			    ] ;
         			    rr:predicateObjectMap [
         			        rr:predicate pofn:lookupValue ;
         			        rr:objectMap [
         			            fnml:functionValue [
         			                rr:predicateObjectMap [
         			                    rr:predicate fno:executes ;
         			                    rr:objectMap [ rr:constant pofn:stripParty ]
         			                ] ;
         			                rr:predicateObjectMap [
         			                    rr:predicate grel:valueParameter ;
         			                    rr:objectMap [ rml:reference "." ]
         			                ]
         			            ]
         			        ]
         			    ] ;
                    ]
                ]
            ]
			] ;
		]
	] ;

	.
