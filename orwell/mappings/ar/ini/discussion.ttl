@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:    <https://w3id.org/function/ontology#> .
@prefix idlab: <https://w3id.org/imec/idlab/function#> .
@prefix pofn:   <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> . # TODO: Update URI to match where the pofn file is hosted
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:    <http://www.w3.org/XML/1998/namespace> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix ocd:    <http://dati.camera.it/ocd/> .
@prefix m4s:    <http://purl.org/map4scrutiny-core#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix sem: <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix pe:     <https://ukparliament.github.io/ontologies/election/election-ontology.ttl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix polis-ini:    <http://purl.org/polis/ar/initiatives#> .
@prefix polis-bio:    <http://purl.org/polis/ar/biographic#> .
@prefix polis-core:   <http://purl.org/polis/ar/core#> .
@prefix polis-graph:  <http://purl.org/polis/ar/graph#> .

<#DiscussionMap> a rr:TriplesMap ;

    rml:logicalSource [
	    rml:source "iniciativas" ;
	    rml:referenceFormulation ql:XPath ;
	    rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/Intervencoesdebates/pt_gov_ar_objectos_IntervencoesOut" ;
	] ;

	rr:subjectMap [
		rr:class ocd:discussione;
		rr:termType rr:IRI ;
		fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:hashIri ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:prefix ;
                rr:objectMap [ rr:constant "urn:discussion:" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "dataReuniaoPlenaria" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "oradores" ]
            ] ;
        ]
	] ;

	# Date
	rr:predicateObjectMap [
		rr:predicate dct:date ;
		rr:objectMap [
		    rr:datatype xsd:date ;
		    rml:reference "dataReuniaoPlenaria" ;
		]
	] ;

	# Summary
	rr:predicateObjectMap [
		rr:predicate dct:abstract ;
		rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "oradores/pt_gov_ar_objectos_peticoes_OradoresOut/sumario" ]
                ]
            ]
        ]
	] ;
	.

<#InterventionMap> a rr:TriplesMap ;

    rml:logicalSource [
	    rml:source "iniciativas" ;
	    rml:referenceFormulation ql:XPath ;
	    rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/Intervencoesdebates/pt_gov_ar_objectos_IntervencoesOut/oradores/pt_gov_ar_objectos_peticoes_OradoresOut" ;
	] ;

	rr:subjectMap [
		rr:class ocd:intervento ;
		rr:termType rr:IRI ;
		fnml:functionValue [
			rr:predicateObjectMap [
				rr:predicate fno:executes ;
				rr:objectMap [ rr:constant pofn:hashIri ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:prefix ;
				rr:objectMap [ rr:constant "urn:intervention:" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "horaInicio" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "horaTermo" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "faseSessao" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "sumario" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "linkVideo" ]
			] ;
		]
	] ;

	# Video URL
	rr:predicateObjectMap [
		rr:predicate schema:url ;
		rr:objectMap [
			rr:datatype xsd:string ;
			rml:reference "linkVideo/pt_gov_ar_objectos_peticoes_LinksVideos/link" ;
		]
	] ;

	# Published in DAR
	rr:predicateObjectMap [
        rr:predicate polis-ini:isPublishedInDAR ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:hashIri ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:prefix ;
                    rr:objectMap [ rr:constant "urn:darPublication:" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "publicacao/pt_gov_ar_objectos_PublicacoesOut/URLDiario" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "publicacao/pt_gov_ar_objectos_PublicacoesOut/idPag" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "publicacao/pt_gov_ar_objectos_PublicacoesOut/pag" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "publicacao/pt_gov_ar_objectos_PublicacoesOut/pubNr" ]
                ] ;
            ]
        ]
    ]
	.

<#DiscussionInterventionMap> a rr:TriplesMap ;

	rml:logicalSource [
		rml:source "iniciativas" ;
		rml:referenceFormulation ql:XPath ;
		rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/Intervencoesdebates/pt_gov_ar_objectos_IntervencoesOut/oradores/pt_gov_ar_objectos_peticoes_OradoresOut" ;
	] ;

	rr:subjectMap [
		rr:class ocd:discussione;
		rr:termType rr:IRI ;
		fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:hashIri ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:prefix ;
                rr:objectMap [ rr:constant "urn:discussion:" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "../../dataReuniaoPlenaria" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "../../oradores" ]
            ] ;
        ]
	] ;

	rr:predicateObjectMap [
		rr:predicate ocd:rif_intervento ;
		rr:objectMap [
		    rr:termType rr:IRI ;
		    fnml:functionValue [
				rr:predicateObjectMap [
					rr:predicate fno:executes ;
					rr:objectMap [ rr:constant pofn:hashIri ]
				] ;
				rr:predicateObjectMap [
					rr:predicate pofn:prefix ;
					rr:objectMap [ rr:constant "urn:intervention:" ]
				] ;
				rr:predicateObjectMap [
					rr:predicate pofn:elements ;
					rr:objectMap [ rml:reference "horaInicio" ]
				] ;
				rr:predicateObjectMap [
					rr:predicate pofn:elements ;
					rr:objectMap [ rml:reference "horaTermo" ]
				] ;
				rr:predicateObjectMap [
					rr:predicate pofn:elements ;
					rr:objectMap [ rml:reference "faseSessao" ]
				] ;
				rr:predicateObjectMap [
					rr:predicate pofn:elements ;
					rr:objectMap [ rml:reference "sumario" ]
				] ;
				rr:predicateObjectMap [
					rr:predicate pofn:elements ;
					rr:objectMap [ rml:reference "linkVideo" ]
				] ;
			]
		]
	] ;
	.
