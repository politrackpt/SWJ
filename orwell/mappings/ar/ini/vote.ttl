@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:    <https://w3id.org/function/ontology#> .
@prefix idlab: <https://w3id.org/imec/idlab/function#> .
@prefix pofn:   <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> . # TODO: Update URI to match where the pofn file is hosted
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:    <http://www.w3.org/XML/1998/namespace> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix ocd:    <http://dati.camera.it/ocd/> .
@prefix m4s:    <http://purl.org/map4scrutiny-core#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix sem: <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix pe:     <https://ukparliament.github.io/ontologies/election/election-ontology.ttl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix polis-ini:    <http://purl.org/polis/ar/initiatives#> .
@prefix polis-bio:    <http://purl.org/polis/ar/biographic#> .
@prefix polis-core:   <http://purl.org/polis/ar/core#> .
@prefix polis-graph:  <http://purl.org/polis/ar/graph#> .

<#VoteMap> a rr:TriplesMap ;

    rml:logicalSource [
	    rml:source "iniciativas" ;
	    rml:referenceFormulation ql:XPath ;
	    rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/Votacao/pt_gov_ar_objectos_VotacaoOut" ;
	] ;

	rr:subjectMap [
		rr:class ocd:votazione ;
		rr:termType rr:IRI ;
		fnml:functionValue [
			rr:predicateObjectMap [
				rr:predicate fno:executes ;
				rr:objectMap [ rr:constant pofn:hashIri ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:prefix ;
				rr:objectMap [ rr:constant "urn:vote:" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "id" ]
			] ;
		]
	] ;

	# Identifer
	rr:predicateObjectMap [
		rr:predicate polis-core:identifier ;
		rr:objectMap [
		    rml:reference "id" ;
		    rr:datatype xsd:string
		]
	] ;

	# Result
	rr:predicateObjectMap [
		rr:predicate polis-ini:result ;
		rr:objectMap [
		    rml:reference "resultado" ;
		    rr:datatype xsd:string
		]
	] ;

	# Reunion Number
	rr:predicateObjectMap [
		rr:predicate polis-ini:reunionNumber ;
		rr:objectMap [
		    rml:reference "reuniao" ;
		    rr:datatype xsd:int
		]
	] ;

	# Reunion Type
	rr:predicateObjectMap [
		rr:predicate polis-ini:reunionType ;
		rr:objectMap [
		    rml:reference "tipoReuniao" ;
		    rr:datatype xsd:string
		]
	] ;

	# Date
	rr:predicateObjectMap [
		rr:predicate dct:date ;
		rr:objectMap [
		    rml:reference "data" ;
		    rr:datatype xsd:date
		]
	] ;

	# Description
	rr:predicateObjectMap [
		rr:predicate dct:description ;
		rr:objectMap [
		    rml:reference "descricao" ;
		    rr:datatype xsd:string
		]
	] ;

	# Unanimous
	rr:predicateObjectMap [
        rr:predicate polis-ini:unanimous ;
        rr:objectMap [
            rr:datatype xsd:boolean ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:controls_if ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:bool_b ;
                    rr:objectMap [
                        rr:datatype xsd:boolean ;
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant idlab:isNull ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate idlab:str ;
                                rr:objectMap [ rml:reference "unanime" ]
                            ] ;
                        ]
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:any_true ;
                    rr:objectMap [
                        rr:constant "false" ;
                        rr:datatype xsd:boolean
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:any_false ;
                    rr:objectMap [
                        rr:constant "true" ;
                        rr:datatype xsd:boolean
                    ]
                ] ;
            ]
        ]
    ] ;
	.

<#VoteDARPublicationRelationMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "iniciativas" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/Votacao/pt_gov_ar_objectos_VotacaoOut/publicacao/pt_gov_ar_objectos_PublicacoesOut" ;
    ] ;

    rr:subjectMap [
        rr:class ocd:votazione ;
        rr:termType rr:IRI ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:hashIri ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:prefix ;
                rr:objectMap [ rr:constant "urn:vote:" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "../../id" ]
            ] ;
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-ini:isPublishedInDAR ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:hashIri ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:prefix ;
                    rr:objectMap [ rr:constant "urn:darPublication:" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "URLDiario" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "idPag" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "pag" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "pubNr" ]
                ] ;
            ]
        ]
    ]
	.

<#VoteAbsenteeRelationMap> a rr:TriplesMap ;

    rml:logicalSource [
	    rml:source "iniciativas" ;
	    rml:referenceFormulation ql:XPath ;
	    rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/Votacao/pt_gov_ar_objectos_VotacaoOut/ausencias/string" ;
	] ;

	rr:subjectMap [
		rr:class ocd:votazione ;
		rr:termType rr:IRI ;
		fnml:functionValue [
			rr:predicateObjectMap [
				rr:predicate fno:executes ;
				rr:objectMap [ rr:constant pofn:hashIri ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:prefix ;
				rr:objectMap [ rr:constant "urn:vote:" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "../../id" ]
			] ;
		]
	] ;

    # Absentees
    rr:predicateObjectMap [
        rr:predicate polis-ini:hasAbsentee ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#ParliamentaryGroup_" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:stringConcat ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:leftPart ;
                                rr:objectMap [ rml:reference "." ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:rightPart ;
                                rr:objectMap [
                                    fnml:functionValue [
                                        rr:predicateObjectMap [
                                            rr:predicate fno:executes ;
                                            rr:objectMap [ rr:constant pofn:stringConcat ]
                                        ] ;
                                        rr:predicateObjectMap [
                                            rr:predicate pofn:leftPart ;
                                            rr:objectMap [ rr:constant "_of_" ]
                                        ] ;
                                        rr:predicateObjectMap [
                                            rr:predicate pofn:rightPart ;
                                            rr:objectMap [ rml:reference "../../legislatura" ]
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]
    .

<#PartyVoteInFavorMap> a rr:TriplesMap ;

    rml:logicalSource [
	    rml:source "iniciativas" ;
	    rml:referenceFormulation ql:XPath ;
	    rml:iterator "//IniEventos/Pt_gov_ar_objectos_iniciativas_EventosOut/Votacao/pt_gov_ar_objectos_VotacaoOut/votings/parliamentaryGroup/aFavor" ;
	] ;

	rr:subjectMap [
		rr:class ocd:votazione ;
		rr:termType rr:IRI ;
		fnml:functionValue [
			rr:predicateObjectMap [
				rr:predicate fno:executes ;
				rr:objectMap [ rr:constant pofn:hashIri ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:prefix ;
				rr:objectMap [ rr:constant "urn:vote:" ]
			] ;
			rr:predicateObjectMap [
				rr:predicate pofn:elements ;
				rr:objectMap [ rml:reference "../../../id" ]
			] ;
		]
	] ;

	rr:predicateObjectMap [
        rr:predicate polis-ini:hasVoteInFavourFrom ;
        rr:objectMap [
            rr:termType rr:IRI ;
            rr:template "http://purl.org/polis/ar/graph#ParliamentaryGroup_{.}_of_{../../../legislatura}"
        ]
    ] ;
	.

