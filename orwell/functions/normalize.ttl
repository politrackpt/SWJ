@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix fnom: <https://w3id.org/function/vocabulary/mapping#> .
@prefix fnoi: <https://w3id.org/function/vocabulary/implementation#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
# TODO: Update URI to match where this function is hosted
@prefix :     <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> .

:normalize a fno:Function ;
    fno:name "normalize" ;
    fno:expects ( :inputStringParam ) ;
    fno:returns ( :normalizedOutputParam ) .

:inputStringParam a fno:Parameter ;
    fno:predicate :inputString ;
    fno:name "inputString" ;
    fno:description "Input string to normalize (trim, lowercase, remove diacritics, remove punctuation and hyphenate spaces)." ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:normalizedOutputParam a fno:Output ;
    fno:predicate :output ;
    fno:name "output" ;
    fno:description "Normalized string (trimmed, lowercased, diacritics removed, punctuation removed, spaces hyphenated)." ;
    fno:type xsd:string .

:normalizeImpl a fnoi:JavaClass ;
    doap:download-page "build/libs/orwell-1.0-SNAPSHOT.jar" ;
    fnoi:class-name "rdf.mapping.functions.Normalize" .

:normalizeMapping a fno:Mapping ;
    fno:function :normalize ;
    fno:implementation :normalizeImpl ;
    fno:methodMapping [ a fnom:StringMethodMapping ; fnom:method-name "normalize" ]
.
