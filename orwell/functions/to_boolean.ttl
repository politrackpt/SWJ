@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix fnom: <https://w3id.org/function/vocabulary/mapping#> .
@prefix fnoi: <https://w3id.org/function/vocabulary/implementation#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
# TODO: Update URI to match where this function is hosted
@prefix :     <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> .

:toBoolean a fno:Function ;
    fno:name "toBoolean" ;
    fno:expects ( :stringValueParam ) ;
    fno:returns ( :booleanOutputParam ) .

:stringValueParam a fno:Parameter ;
    fno:predicate :stringValue ;
    fno:name "stringValue" ;
    fno:description "String value (e.g., S or N)." ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:booleanOutputParam a fno:Output ;
    fno:predicate :output ;
    fno:name "output" ;
    fno:description "Output boolean value." ;
    fno:type xsd:boolean .

:toBooleanImpl a fnoi:JavaClass ;
    doap:download-page "build/libs/orwell-1.0-SNAPSHOT.jar" ;
    fnoi:class-name "rdf.mapping.functions.ToBoolean" .

:toBooleanMapping a fno:Mapping ;
    fno:function :toBoolean ;
    fno:implementation :toBooleanImpl ;
    fno:methodMapping [ a fnom:StringMethodMapping ; fnom:method-name "toBoolean" ]
.
